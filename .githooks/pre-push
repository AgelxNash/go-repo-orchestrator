#!/bin/sh

set -e

# Хуки worktree получают GIT_DIR на реальный репозиторий; без очистки он
# наследуется git-подпроцессами тестов (make check -> go test) и уводит их
# из временных каталогов в рабочее дерево проекта (issue #62).
for git_env in $(env | cut -d= -f1 | grep '^GIT_' || true); do
	unset "$git_env"
done

# Полная локальная проверка перед push
make check
